@@ -1,7 +1,19 @@
 import { NextResponse } from 'next/server'
 import type { NextRequest } from 'next/server'
+import { createServerClient } from '@supabase/ssr'
 
-export function middleware(request: NextRequest) {
+// Routes accessibles sans authentification
+const PUBLIC_PATHS = ['/', '/landing', '/guide']
+const PUBLIC_PREFIXES = ['/auth', '/api/lti', '/modules']
+
+// Routes API nécessitant une session (protègent les crédits IA et BBB)
+const PROTECTED_API = ['/api/ai-tutor', '/api/generate-course', '/api/market-chat', '/api/bbb']
+
+function isPublic(pathname: string) {
+  return PUBLIC_PATHS.includes(pathname) || PUBLIC_PREFIXES.some(p => pathname.startsWith(p))
+}
+
+export async function middleware(request: NextRequest) {
   const { pathname } = request.nextUrl
 
   // ── Bloquer /api/check-env en production sans token admin ──────────────────
@@ -14,7 +26,47 @@ export function middleware(request: NextRequest) {
     }
   }
 
-  const response = NextResponse.next()
+  let response = NextResponse.next({ request })
+
+  const supabase = createServerClient(
+    process.env.NEXT_PUBLIC_SUPABASE_URL!,
+    process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY!,
+    {
+      cookies: {
+        getAll() { return request.cookies.getAll() },
+        setAll(toSet) {
+          toSet.forEach(({ name, value }) => request.cookies.set(name, value))
+          response = NextResponse.next({ request })
+          toSet.forEach(({ name, value, options }) => response.cookies.set(name, value, options))
+        },
+      },
+    }
+  )
+
+  const { data: { user } } = await supabase.auth.getUser()
+
+  // ── Routes API protégées : 401 JSON plutôt qu'une redirection ──────────────
+  if (PROTECTED_API.some(p => pathname.startsWith(p))) {
+    if (!user) {
+      return NextResponse.json({ error: 'Authentification requise' }, { status: 401 })
+    }
+  } else if (!user && !isPublic(pathname) && !pathname.startsWith('/api/')) {
+    // ── Pages protégées : redirection vers la page de connexion ──────────────
+    return NextResponse.redirect(new URL('/', request.url))
+  }
+
+  // ── Espaces réservés par rôle (rôle lu en base, jamais depuis le client) ───
+  if (user && (pathname.startsWith('/admin') || pathname.startsWith('/formateur'))) {
+    const { data: profile } = await supabase
+      .from('profiles').select('role').eq('id', user.id).single()
+    const role = profile?.role ?? 'learner'
+    const allowed = pathname.startsWith('/admin')
+      ? role === 'admin'
+      : role === 'admin' || role === 'formateur' || role === 'teacher'
+    if (!allowed) {
+      return NextResponse.redirect(new URL('/dashboard', request.url))
+    }
+  }
 
   // ── Security headers sur toutes les réponses ───────────────────────────────
   response.headers.set('X-Content-Type-Options', 'nosniff')
@@ -26,5 +78,5 @@ export function middleware(request: NextRequest) {
 }
 
 export const config = {
-  matcher: ['/((?!_next/static|_next/image|favicon.ico).*)'],
+  matcher: ['/((?!_next/static|_next/image|favicon.ico|.*\\.svg|.*\\.png|.*\\.pdf|.*\\.html).*)'],
 }
