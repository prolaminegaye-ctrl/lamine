# =====================================================
# ETAGIA LMS — Variables d'environnement
# Copier ce fichier en .env.local pour développement
# Ajouter chaque variable dans Vercel > Settings > Environment Variables
# =====================================================

# --- SUPABASE (obligatoire) ---
# Récupérer dans Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...votre_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJ...votre_service_role_key   # NE JAMAIS exposer côté client

# --- SENTRY (monitoring d'erreurs) ---
# Récupérer dans Sentry > Settings > Projects > Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=https://XXXX@oXXX.ingest.sentry.io/YYYY
SENTRY_ORG=votre-organisation-sentry
SENTRY_PROJECT=etagia-lms
SENTRY_AUTH_TOKEN=sntrys_...   # Sentry > Settings > Auth Tokens (pour upload des source maps)

# --- ANTHROPIC / CLAUDE AI (tutor IA) ---
# Récupérer dans console.anthropic.com > API Keys
ANTHROPIC_API_KEY=sk-ant-...

# --- BACKUP SUPABASE (GitHub Actions uniquement) ---
# Ajouter dans GitHub > Settings > Secrets and variables > Actions
BACKUP_SUPABASE_URL=https://VOTRE_PROJECT_ID.supabase.co
BACKUP_SUPABASE_SERVICE_KEY=eyJ...votre_service_role_key

# =====================================================
# CHECKLIST VERCEL
# Dans Vercel > ton projet > Settings > Environment Variables
# Ajouter : NEXT_PUBLIC_SUPABASE_URL
#           NEXT_PUBLIC_SUPABASE_ANON_KEY
#           SUPABASE_SERVICE_ROLE_KEY
#           NEXT_PUBLIC_SENTRY_DSN
#           SENTRY_ORG
#           SENTRY_PROJECT
#           SENTRY_AUTH_TOKEN
#           ANTHROPIC_API_KEY
# =====================================================
